    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- No <includes> here on purpose. The previous value was a single
                         <include>**/*Test.java</include>, which forces surefire to
                         translate a source-shaped pattern into the .class names it
                         actually scans. That translation is the one discovery step
                         whose behaviour changed between 3.5.3 and 3.6.0: on the Linux
                         runner 3.6.0 selected the JUnit Platform provider, printed
                         "Tests run: 0" and exited 0 without ever naming a test class,
                         while 3.5.3 ran all 188. Surefire's built-in defaults already
                         match **/*Test.java, **/Test*.java and **/*Tests.java, so
                         dropping the override removes the fragile step instead of
                         replacing it with another guess. -->
                    <!-- Tests must fail the build when they fail. This was true until
                         2026-10-03, and it hid 50 failures + 5 errors behind a green
                         check: CI reported success while the suite was broken.
                         Left on "so the build still produces a JAR". The suite is green
                         now, so it is off again — keep it off. -->
                    <testFailureIgnore>false</testFailureIgnore>
                    <argLine>-Dnet.bytebuddy.experimental -Dnet.bytebuddy.dont-enable-optional-strict-floating-point=true -Dmockito.inline.mockmaker=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals><goal>toolchain</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>25</version>
                            <vendor>any</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>
    </build>

