<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- parent pom -->
    <parent>
        <artifactId>shop-parent</artifactId>
        <groupId>com.snowgears.shop</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>shop-dist</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.snowgears.shop</groupId>
            <artifactId>shop-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <directory>../target</directory>
        <finalName>Shop-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- 3.6.0 is the latest released version. Java 25 support requires
                     overriding the bundled ASM with 9.7.1 which supports class
                     file major version 69 (Java 25). -->
                <version>3.6.0</version>
                <dependencies>
                    <!-- Override the ASM version bundled in shade 3.6.0 with one
                         that understands Java 25 class files (major version 69). -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.7.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.7.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Explicitly exclude provided-scope / server-side artifacts so
                                 shade never tries to open their class files at all. -->
                            <artifactSet>
                                <excludes>
                                    <exclude>io.papermc.paper:*</exclude>
                                    <exclude>org.spigotmc:*</exclude>
                                    <exclude>net.milkbowl.vault:*</exclude>
                                    <exclude>com.github.MilkBowl:*</exclude>
                                    <exclude>com.sk89q.worldguard:*</exclude>
                                    <exclude>com.sk89q.worldedit:*</exclude>
                                    <exclude>us.dynmap:*</exclude>
                                    <exclude>com.github.spnda:*</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <!-- Relocate FoliaLib to our namespace to avoid classpath
                                     conflicts with other plugins that also bundle FoliaLib. -->
                                <relocation>
                                    <pattern>com.tcoded.folialib</pattern>
                                    <shadedPattern>com.snowgears.shop.libs.folialib</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
