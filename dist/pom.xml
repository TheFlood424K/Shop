<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- parent pom -->
    <parent>
        <artifactId>shop-parent</artifactId>
        <groupId>com.snowgears.shop</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>shop-dist</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.snowgears.shop</groupId>
            <artifactId>shop-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <directory>../target</directory>
        <finalName>Shop-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <!-- ASM 9.7.1 supports Java 25 class file major version 69.
                         This overrides the older ASM bundled inside shade 3.6.0
                         so it can process our Java-25-compiled plugin classes. -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.7.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.7.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Skip all provided-scope / server-side artifacts.
                                 shade must never open these jars. -->
                            <artifactSet>
                                <excludes>
                                    <exclude>io.papermc.paper:*</exclude>
                                    <exclude>org.spigotmc:*</exclude>
                                    <exclude>net.milkbowl.vault:*</exclude>
                                    <exclude>com.github.MilkBowl:*</exclude>
                                    <exclude>com.sk89q.worldguard:*</exclude>
                                    <exclude>com.sk89q.worldedit:*</exclude>
                                    <exclude>us.dynmap:*</exclude>
                                    <exclude>com.github.spnda:*</exclude>
                                    <exclude>net.kyori:*</exclude>
                                </excludes>
                            </artifactSet>

                            <!-- Strip any net/kyori classes that may still sneak in
                                 transitively through compile-scoped jars. -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>net/kyori/**</exclude>
                                        <exclude>META-INF/versions/*/net/kyori/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <relocations>
                                <relocation>
                                    <pattern>com.tcoded.folialib</pattern>
                                    <shadedPattern>com.snowgears.shop.libs.folialib</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
